# exvia -- remote operations relay tool (cli / agent / relay) for
# outbound-restricted networks. Source RPM is produced by
# scripts/make-srpm.sh (git archive, no vendored deps; crates are fetched
# online at build time, versions pinned by Cargo.lock). Minimum toolchain
# is Cargo.toml's rust-version.

# release builds carry no extractable debug sources; without this the
# debugsource subpackage fails on its empty file list
%define debug_package %{nil}

# Three supported build paths, selected by rpmbuild --define:
#   (default)        cargo builds from source inside %%build (distribution
#                    path; crates are fetched online, versions pinned by
#                    Cargo.lock)
#   cargo_target     e.g. --define 'cargo_target x86_64-unknown-linux-musl'
#                    makes %%build pass --target to cargo and %%install pick
#                    the binaries from that target dir
#   prebuilt_dir     e.g. --define 'prebuilt_dir target/x86_64-.../release'
#                    skips %%build entirely and installs the provided
#                    binaries; required when the build needs a toolchain
#                    rpmbuild cannot set up itself (cross jobs in CI)
#   completions_dir  directory with pre-generated shell completions
#                    (exvia.bash, _exvia, exvia.fish); required for cross
#                    builds, where the foreign-arch cli cannot run on the
#                    build host. Native builds leave it unset and %%install
#                    generates the completions from the built binary.
%{!?cargo_target: %define cargo_target %{nil}}
%{!?prebuilt_dir: %define prebuilt_dir %{nil}}
%{!?completions_dir: %define completions_dir %{nil}}
%if "%{prebuilt_dir}" != ""
%define bindir %{prebuilt_dir}
%else
%if "%{cargo_target}" != ""
%define bindir target/%{cargo_target}/release
%else
%define bindir target/release
%endif
%endif

Name:           exvia
Version:        0.1.0
Release:        1%{?dist}
Summary:        Remote operations tool for outbound-restricted networks (relay + agent + cli)
License:        MulanPSL-2.0
URL:            https://github.com/jiachao2130/exvia
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  cargo
BuildRequires:  gcc

%description
exvia provides full remote operations -- terminal, file transfer, and
port forwarding -- for machines sitting behind strict egress controls
(no public IP, only a few outbound TCP ports allowed). All connections
are outbound-only; managed machines open no inbound port. Session content
is end-to-end encrypted (Noise XX) and the relay is treated as an
untrusted component: it cannot read plaintext and cannot forge
session authorization.

%package agent
Summary:        exvia agent: outbound-only endpoint serving terminal/file/forward sessions
Requires:       %{name} = %{version}-%{release}

%description agent
Daemon running on managed machines. Maintains a single outbound WSS
connection to the relay and listens on no inbound port. Accepts session
invitations only after independently verifying the CLI's signed ticket
against a locally pinned allowlist; serves interactive terminal, file
transfer, and port forwarding.

%package relay
Summary:        exvia relay: machine registry, session matchmaking, ciphertext ferry
Requires:       %{name} = %{version}-%{release}

%description relay
Public relay. Terminates built-in TLS (self-signed certificate with
fingerprint pinning) on a dedicated configurable port; only registers
machines, pairs session streams, and ferries end-to-end ciphertext. It
does not understand -- and cannot read -- session content, so it can be
hosted in an untrusted environment.

%prep
%autosetup

%build
%if "%{prebuilt_dir}" == ""
%if "%{cargo_target}" != ""
cargo build --release --locked --target %{cargo_target}
%else
cargo build --release --locked
%endif
%endif

%install
install -Dpm755 %{bindir}/exvia %{buildroot}%{_bindir}/exvia
install -Dpm755 %{bindir}/exvia-agent %{buildroot}%{_bindir}/exvia-agent
install -Dpm755 %{bindir}/exvia-relay %{buildroot}%{_bindir}/exvia-relay
# shell completions: generated by the cli itself (single source of truth);
# cross builds hand in pre-generated files instead, see completions_dir
%if "%{completions_dir}" != ""
install -Dpm644 %{completions_dir}/exvia.bash %{buildroot}%{_datadir}/bash-completion/completions/exvia
install -Dpm644 %{completions_dir}/_exvia %{buildroot}%{_datadir}/zsh/site-functions/_exvia
install -Dpm644 %{completions_dir}/exvia.fish %{buildroot}%{_datadir}/fish/vendor_completions.d/exvia.fish
%else
%{bindir}/exvia completion bash > exvia.bash
%{bindir}/exvia completion zsh > _exvia
%{bindir}/exvia completion fish > exvia.fish
install -Dpm644 exvia.bash %{buildroot}%{_datadir}/bash-completion/completions/exvia
install -Dpm644 _exvia %{buildroot}%{_datadir}/zsh/site-functions/_exvia
install -Dpm644 exvia.fish %{buildroot}%{_datadir}/fish/vendor_completions.d/exvia.fish
%endif

%files
%{_bindir}/exvia
%{_datadir}/bash-completion/completions/exvia
%{_datadir}/zsh/site-functions/_exvia
%{_datadir}/fish/vendor_completions.d/exvia.fish
%doc README.md docs/design.md docs/requirements.md docs/operations.md
%license LICENSE

%files agent
%{_bindir}/exvia-agent

%files relay
%{_bindir}/exvia-relay

